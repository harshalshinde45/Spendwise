# Server Port
PORT=5001

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/spendwise?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Multi-User Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini AI Integration (Optional)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
